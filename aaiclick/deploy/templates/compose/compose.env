# Credentials for docker-compose.yaml, written by `python -m aaiclick compose init`.
# Each secret lives only here. Keep this file out of version control.
# A database password also goes into the connection URL, so use URL-safe
# characters (letters, digits, `-`, `_`) when you set your own.
AAICLICK_PG_PASSWORD=change-me-postgres
AAICLICK_CH_PASSWORD=change-me-clickhouse
AAICLICK_JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
AAICLICK_ADMIN_PASSWORD=change-me-admin-password
